#!/usr/bin/env bash

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

# Set working directory to home directory
cd "${HOME}"

<%- unless context.modules.blank? -%>
# Purge the module environment to avoid conflicts
module purge

# Load the require modules
module load <%= context.modules %>

# List loaded modules
module list
<%- end -%>

# Benchmark info
echo "TIMING - Starting CellProfiler at: $(date)"

# Launch CellProfiler using xpra
set -x
apptainer exec ${CONTAINER} xpra start \
    --mdns=no \
    --bind-tcp=0.0.0.0:${PORT},auth=file,filename=${PASSWORD_FILE} \
    --websocket-upgrade=yes \
    --socket-dirs=${XDG_RUNTIME_DIR} \
    --html=on \
    --resize-display=yes \
    --dpi=96 \
    --file-transfer=no \
    --open-files=no \
    --open-url=no \
    --printing=no \
    --webcam=no \
    --notifications=no \
    --system-tray=no \
    --audio=no \
    --start-child-after-connect="cellprofiler" \
    --exit-with-windows=yes \
    --clipboard=yes \
    --daemon=no \
    --xvfb="Xvfb" \
    $DISPLAY
